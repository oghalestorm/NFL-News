<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NFL Wire — Live Team Headlines</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0b;
    --surface: #111114;
    --surface2: #1a1a1f;
    --border: rgba(255,255,255,0.07);
    --border2: rgba(255,255,255,0.13);
    --accent: #e8ff47;
    --accent2: #ff5c38;
    --text: #f0f0f0;
    --muted: #888;
    --tag-injury: #ff5c38;
    --tag-contract: #4ade80;
    --tag-trade: #60a5fa;
    --tag-legal: #f87171;
    --tag-ota: #a78bfa;
    --tag-coaching: #fbbf24;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Barlow', sans-serif;
    min-height: 100vh;
  }

  /* HEADER */
  header {
    border-bottom: 1px solid var(--border2);
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10,10,11,0.95);
    backdrop-filter: blur(12px);
  }
  .logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 26px;
    letter-spacing: -0.5px;
    color: var(--text);
  }
  .logo span { color: var(--accent); }
  .header-right { display: flex; align-items: center; gap: 1rem; }
  #status-badge {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--surface2);
    color: var(--muted);
    border: 1px solid var(--border);
  }
  #status-badge.live { background: rgba(232,255,71,0.12); color: var(--accent); border-color: rgba(232,255,71,0.3); }
  #status-badge.loading { background: rgba(96,165,250,0.12); color: #60a5fa; border-color: rgba(96,165,250,0.3); animation: pulse 1.5s ease-in-out infinite; }
  #status-badge.error { background: rgba(248,113,113,0.12); color: #f87171; border-color: rgba(248,113,113,0.3); }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }
  #refresh-btn {
    background: var(--surface2);
    border: 1px solid var(--border2);
    color: var(--text);
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
    padding: 6px 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #refresh-btn:hover { background: var(--surface); border-color: var(--border2); color: var(--accent); }
  #refresh-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  #refresh-btn svg { width: 14px; height: 14px; }

  /* MAIN LAYOUT */
  .main { max-width: 1600px; margin: 0 auto; padding: 2rem; }

  /* TICKER */
  #ticker-wrap {
    background: var(--accent);
    color: #0a0a0b;
    height: 36px;
    overflow: hidden;
    margin-bottom: 2rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
  }
  .ticker-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 1px;
    padding: 0 14px;
    white-space: nowrap;
    background: #0a0a0b;
    color: var(--accent);
    height: 100%;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .ticker-track {
    display: flex;
    gap: 0;
    animation: ticker 60s linear infinite;
    white-space: nowrap;
  }
  .ticker-item {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.3px;
    padding: 0 2rem;
  }
  .ticker-item::before { content: "● "; font-size: 8px; vertical-align: middle; }
  @keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

  /* CONTROLS */
  .controls {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .search-wrap {
    position: relative;
    flex: 1;
    min-width: 200px;
    max-width: 320px;
  }
  .search-wrap svg {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    color: var(--muted);
  }
  #search {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border2);
    color: var(--text);
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    padding: 8px 12px 8px 34px;
    border-radius: 4px;
    outline: none;
    transition: border-color 0.15s;
  }
  #search:focus { border-color: rgba(232,255,71,0.4); }
  #search::placeholder { color: var(--muted); }

  .div-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .pill {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 3px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.12s;
  }
  .pill:hover { border-color: var(--border2); color: var(--text); }
  .pill.active { background: var(--accent); color: #0a0a0b; border-color: var(--accent); }

  /* STATS ROW */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
    margin-bottom: 1.5rem;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px 16px;
  }
  .stat-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .stat-val {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 26px;
    font-weight: 800;
    line-height: 1;
  }

  /* GRID */
  #grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 12px;
  }

  /* CARD */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: var(--border2); transform: translateY(-1px); }
  .card-head {
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .abbr-box {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 0.5px;
    background: var(--surface2);
    color: var(--accent);
    padding: 4px 8px;
    border-radius: 3px;
    min-width: 42px;
    text-align: center;
  }
  .team-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2px;
    flex: 1;
  }
  .conf-tag {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-body { padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; }
  .item { display: flex; gap: 8px; align-items: flex-start; }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--border2); margin-top: 7px; flex-shrink: 0; }
  .item-text { font-size: 13px; line-height: 1.5; color: #ccc; }
  .tag {
    display: inline-block;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 2px;
    margin-right: 5px;
    vertical-align: middle;
    opacity: 0.9;
  }
  .tag-injury { background: rgba(255,92,56,0.15); color: var(--tag-injury); }
  .tag-contract { background: rgba(74,222,128,0.12); color: var(--tag-contract); }
  .tag-trade { background: rgba(96,165,250,0.12); color: var(--tag-trade); }
  .tag-legal { background: rgba(248,113,113,0.12); color: var(--tag-legal); }
  .tag-ota { background: rgba(167,139,250,0.12); color: var(--tag-ota); }
  .tag-coaching { background: rgba(251,191,36,0.12); color: var(--tag-coaching); }
  .tag-general { background: rgba(136,136,136,0.15); color: #aaa; }

  /* SKELETON */
  .skeleton-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px;
    animation: shimmer 1.5s ease-in-out infinite;
  }
  @keyframes shimmer { 0%,100%{opacity:0.5} 50%{opacity:1} }
  .skel-line {
    background: var(--surface2);
    border-radius: 3px;
    margin-bottom: 8px;
  }

  /* LOADING OVERLAY */
  #loader {
    text-align: center;
    padding: 4rem 2rem;
    display: none;
  }
  #loader.show { display: block; }
  .loader-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .loader-sub { font-size: 14px; color: var(--muted); margin-bottom: 1.5rem; }
  .progress-bar {
    height: 2px;
    background: var(--surface2);
    border-radius: 2px;
    max-width: 320px;
    margin: 0 auto;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    animation: progress 8s ease-in-out infinite;
    width: 0;
  }
  @keyframes progress { 0%{width:0} 70%{width:80%} 100%{width:95%} }
  .log-lines {
    margin-top: 1.5rem;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
  }
  .log-line {
    font-family: 'Barlow Condensed', monospace;
    font-size: 12px;
    color: var(--muted);
    padding: 2px 0;
    opacity: 0;
    animation: fadein 0.3s ease forwards;
  }
  .log-line.ok { color: #4ade80; }
  .log-line.search { color: #60a5fa; }
  @keyframes fadein { to{opacity:1} }

  /* ERROR */
  #error-box {
    display: none;
    background: rgba(248,113,113,0.08);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 8px;
    padding: 1.5rem 2rem;
    text-align: center;
    margin: 2rem 0;
  }
  #error-box.show { display: block; }
  #error-box h3 { color: #f87171; font-family: 'Barlow Condensed', sans-serif; font-size: 18px; font-weight: 700; margin-bottom: 0.5rem; }
  #error-box p { font-size: 13px; color: var(--muted); margin-bottom: 1rem; }
  #error-box button { background: var(--surface2); border: 1px solid rgba(248,113,113,0.3); color: #f87171; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; padding: 6px 16px; border-radius: 4px; cursor: pointer; }

  /* TIMESTAMP */
  #timestamp { font-size: 11px; color: var(--muted); margin-bottom: 1.5rem; }

  /* FOOTER */
  footer { text-align: center; padding: 2rem; font-size: 12px; color: var(--muted); border-top: 1px solid var(--border); margin-top: 3rem; }
  footer strong { color: var(--accent); }
</style>
</head>
<body>

<header>
  <div class="logo">NFL<span>Wire</span></div>
  <div class="header-right">
    <span id="status-badge">Idle</span>
    <button id="refresh-btn" onclick="fetchNews()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6"/><path d="M23 20v-6h-6"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
      Refresh
    </button>
  </div>
</header>

<div id="ticker-wrap">
  <div class="ticker-label">NFL WIRE</div>
  <div id="ticker-scroll" style="overflow:hidden;flex:1;display:flex;align-items:center;">
    <div class="ticker-track" id="ticker">
      <span class="ticker-item">Loading latest headlines...</span>
    </div>
  </div>
</div>

<div class="main">
  <div id="timestamp"></div>

  <div id="loader">
    <div class="loader-title">Scanning NFL news sources</div>
    <div class="loader-sub">Fetching latest headlines for all 32 teams...</div>
    <div class="progress-bar"><div class="progress-fill"></div></div>
    <div class="log-lines" id="log-lines"></div>
  </div>

  <div id="error-box">
    <h3>Could not fetch news</h3>
    <p id="error-msg">Something went wrong. Check your API key and try again.</p>
    <button onclick="fetchNews()">Try Again</button>
  </div>

  <div id="controls-wrap" style="display:none">
    <div class="stats-row" id="stats-row"></div>
    <div class="controls">
      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search" placeholder="Search teams or headlines..." oninput="render()">
      </div>
      <div class="div-pills" id="pills"></div>
    </div>
  </div>

  <div id="grid"></div>
</div>

<footer>
  <strong>NFLWire</strong> — Powered by Claude AI · Headlines refresh live on each page load
</footer>

<script>
const TEAMS = [
  {name:"Arizona Cardinals",abbr:"ARI",conf:"NFC West"},
  {name:"Atlanta Falcons",abbr:"ATL",conf:"NFC South"},
  {name:"Baltimore Ravens",abbr:"BAL",conf:"AFC North"},
  {name:"Buffalo Bills",abbr:"BUF",conf:"AFC East"},
  {name:"Carolina Panthers",abbr:"CAR",conf:"NFC South"},
  {name:"Chicago Bears",abbr:"CHI",conf:"NFC North"},
  {name:"Cincinnati Bengals",abbr:"CIN",conf:"AFC North"},
  {name:"Cleveland Browns",abbr:"CLE",conf:"AFC North"},
  {name:"Dallas Cowboys",abbr:"DAL",conf:"NFC East"},
  {name:"Denver Broncos",abbr:"DEN",conf:"AFC West"},
  {name:"Detroit Lions",abbr:"DET",conf:"NFC North"},
  {name:"Green Bay Packers",abbr:"GB",conf:"NFC North"},
  {name:"Houston Texans",abbr:"HOU",conf:"AFC South"},
  {name:"Indianapolis Colts",abbr:"IND",conf:"AFC South"},
  {name:"Jacksonville Jaguars",abbr:"JAC",conf:"AFC South"},
  {name:"Kansas City Chiefs",abbr:"KC",conf:"AFC West"},
  {name:"Las Vegas Raiders",abbr:"LV",conf:"AFC West"},
  {name:"Los Angeles Chargers",abbr:"LAC",conf:"AFC West"},
  {name:"Los Angeles Rams",abbr:"LAR",conf:"NFC West"},
  {name:"Miami Dolphins",abbr:"MIA",conf:"AFC East"},
  {name:"Minnesota Vikings",abbr:"MIN",conf:"NFC North"},
  {name:"New England Patriots",abbr:"NE",conf:"AFC East"},
  {name:"New Orleans Saints",abbr:"NO",conf:"NFC South"},
  {name:"New York Giants",abbr:"NYG",conf:"NFC East"},
  {name:"New York Jets",abbr:"NYJ",conf:"AFC East"},
  {name:"Philadelphia Eagles",abbr:"PHI",conf:"NFC East"},
  {name:"Pittsburgh Steelers",abbr:"PIT",conf:"AFC North"},
  {name:"San Francisco 49ers",abbr:"SF",conf:"NFC West"},
  {name:"Seattle Seahawks",abbr:"SEA",conf:"NFC West"},
  {name:"Tampa Bay Buccaneers",abbr:"TB",conf:"NFC South"},
  {name:"Tennessee Titans",abbr:"TEN",conf:"AFC South"},
  {name:"Washington Commanders",abbr:"WAS",conf:"NFC East"}
];

const DIVS = ["All","AFC East","AFC North","AFC South","AFC West","NFC East","NFC North","NFC South","NFC West"];
const TAGMAP = {injury:"Injury",contract:"Contract",trade:"Trade",legal:"Legal",ota:"OTA",coaching:"Coaching",general:"News"};

let allData = [];
let activeDiv = "All";

// ── LOG HELPERS ──────────────────────────────────────────────────────────────
let logDelay = 0;
function log(msg, cls="") {
  const el = document.createElement("div");
  el.className = "log-line" + (cls ? " "+cls : "");
  el.textContent = msg;
  el.style.animationDelay = logDelay + "ms";
  logDelay += 220;
  document.getElementById("log-lines").appendChild(el);
}
function clearLog() {
  document.getElementById("log-lines").innerHTML = "";
  logDelay = 0;
}

// ── FETCH ────────────────────────────────────────────────────────────────────
async function fetchNews() {
  // Reset UI
  document.getElementById("refresh-btn").disabled = true;
  document.getElementById("controls-wrap").style.display = "none";
  document.getElementById("grid").innerHTML = "";
  document.getElementById("error-box").classList.remove("show");
  document.getElementById("loader").classList.add("show");
  clearLog();

  const badge = document.getElementById("status-badge");
  badge.textContent = "Scanning...";
  badge.className = "loading";

  log("› Connecting to Claude AI...", "search");
  log("› Requesting web search for all 32 teams...", "search");

  const today = new Date().toLocaleDateString("en-US",{month:"long",day:"numeric",year:"numeric"});
  const prompt = `Today is ${today}. Search the web and find the 3 most recent news headlines for EACH of the 32 NFL teams. For every team, find actual breaking news from the last few weeks — things like player signings, trades, injuries, contract extensions, OTA updates, legal issues, coaching news, etc.

Return ONLY a valid JSON array with no markdown, no code fences, no explanation. Each element must be exactly:
{
  "abbr": "TEAM_ABBR",
  "news": [
    {"text": "concise one-sentence headline", "tag": "one of: injury|contract|trade|legal|ota|coaching|general"},
    {"text": "...", "tag": "..."},
    {"text": "...", "tag": "..."}
  ]
}

Team abbreviations to use exactly: ARI, ATL, BAL, BUF, CAR, CHI, CIN, CLE, DAL, DEN, DET, GB, HOU, IND, JAC, KC, LV, LAC, LAR, MIA, MIN, NE, NO, NYG, NYJ, PHI, PIT, SF, SEA, TB, TEN, WAS

Return all 32 teams. Headlines must be genuinely current — actually search the web. Keep each headline under 140 characters.`;

  try {
    log("› Searching: NFL news all 32 teams ${today}...", "search");

    const resp = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: {"Content-Type":"application/json”, "x-api-key": "1aac3916c7694b6c8a1773a059a4aaf5",
"anthropic-version": "2023-06-01",
"anthropic-dangerous-direct-browser-access": "true"},
      body: JSON.stringify({
        model: "claude-sonnet-4-20250514",
        max_tokens: 8000,
        tools: [{ type: "web_search_20250305", name: "web_search" }],
        messages: [{ role: "user", content: prompt }]
      })
    });

    if (!resp.ok) {
      const err = await resp.json().catch(()=>({}));
      throw new Error(err.error?.message || `HTTP ${resp.status}`);
    }

    const data = await resp.json();

    // Extract text content, handling tool use blocks
    let raw = "";
    for (const block of (data.content || [])) {
      if (block.type === "text") raw += block.text;
    }

    log("› Parsing team data...", "search");

    // Strip any markdown fences if present
    raw = raw.replace(/```json|```/g,"").trim();
    // Try to find JSON array
    const match = raw.match(/\[[\s\S]*\]/);
    if (!match) throw new Error("No JSON array found in response");

    const parsed = JSON.parse(match[0]);
    if (!Array.isArray(parsed) || parsed.length < 20) throw new Error("Incomplete team data returned");

    // Merge with team metadata
    allData = TEAMS.map(t => {
      const found = parsed.find(p => p.abbr === t.abbr);
      return {
        ...t,
        news: found?.news || [{text:"No recent news found.",tag:"general"}]
      };
    });

    log(`› Got headlines for ${allData.length} teams`, "ok");
    log("› Building dashboard...", "ok");

    await new Promise(r=>setTimeout(r,400));

    document.getElementById("loader").classList.remove("show");
    buildUI();

    badge.textContent = "Live";
    badge.className = "live";
    document.getElementById("timestamp").textContent =
      "Last updated: " + new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"}) + " · " + today;

  } catch(e) {
    document.getElementById("loader").classList.remove("show");
    badge.textContent = "Error";
    badge.className = "error";
    document.getElementById("error-msg").textContent = e.message || "Unknown error";
    document.getElementById("error-box").classList.add("show");
    console.error("NFLWire error:", e);
  }

  document.getElementById("refresh-btn").disabled = false;
}

// ── UI BUILDER ───────────────────────────────────────────────────────────────
function buildUI() {
  // Stats
  const tagCounts = {};
  allData.forEach(t=>t.news.forEach(n=>{tagCounts[n.tag]=(tagCounts[n.tag]||0)+1;}));
  const statsEl = document.getElementById("stats-row");
  statsEl.innerHTML = `
    <div class="stat-card"><div class="stat-label">Teams</div><div class="stat-val" style="color:var(--accent)">${allData.length}</div></div>
    <div class="stat-card"><div class="stat-label">Headlines</div><div class="stat-val">${allData.reduce((s,t)=>s+t.news.length,0)}</div></div>
    <div class="stat-card"><div class="stat-label">Injuries</div><div class="stat-val" style="color:var(--tag-injury)">${tagCounts.injury||0}</div></div>
    <div class="stat-card"><div class="stat-label">Trades</div><div class="stat-val" style="color:var(--tag-trade)">${tagCounts.trade||0}</div></div>
    <div class="stat-card"><div class="stat-label">Contracts</div><div class="stat-val" style="color:var(--tag-contract)">${tagCounts.contract||0}</div></div>
    <div class="stat-card"><div class="stat-label">Legal</div><div class="stat-val" style="color:var(--tag-legal)">${tagCounts.legal||0}</div></div>
  `;

  // Pills
  const pillsEl = document.getElementById("pills");
  pillsEl.innerHTML = "";
  DIVS.forEach(d=>{
    const b = document.createElement("button");
    b.className = "pill" + (d===activeDiv?" active":"");
    b.textContent = d;
    b.onclick = ()=>{ activeDiv=d; document.querySelectorAll(".pill").forEach(x=>x.classList.remove("active")); b.classList.add("active"); render(); };
    pillsEl.appendChild(b);
  });

  // Ticker
  const allHeadlines = allData.flatMap(t=>t.news.map(n=>`${t.abbr}: ${n.text}`));
  const doubled = [...allHeadlines,...allHeadlines];
  document.getElementById("ticker").innerHTML = doubled.map(h=>`<span class="ticker-item">${h}</span>`).join("");

  document.getElementById("controls-wrap").style.display = "";
  render();
}

function render() {
  const q = (document.getElementById("search")?.value||"").toLowerCase();
  const filtered = allData.filter(t=>{
    if (activeDiv!=="All" && t.conf!==activeDiv) return false;
    if (q) return t.name.toLowerCase().includes(q)||t.abbr.toLowerCase().includes(q)||t.news.some(n=>n.text.toLowerCase().includes(q));
    return true;
  });

  const grid = document.getElementById("grid");
  if (!filtered.length) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--muted);font-family:'Barlow Condensed',sans-serif;font-size:18px;">No teams found</div>`;
    return;
  }
  grid.innerHTML = filtered.map(t=>`
    <div class="card">
      <div class="card-head">
        <div class="abbr-box">${t.abbr}</div>
        <div class="team-name">${t.name}</div>
        <div class="conf-tag">${t.conf}</div>
      </div>
      <div class="card-body">
        ${t.news.map(n=>`
          <div class="item">
            <div class="dot"></div>
            <div class="item-text"><span class="tag tag-${n.tag}">${TAGMAP[n.tag]||"News"}</span>${n.text}</div>
          </div>`).join("")}
      </div>
    </div>`).join("");
}

// ── INIT ─────────────────────────────────────────────────────────────────────
// Show skeleton while loading
document.getElementById("grid").innerHTML = Array(16).fill(0).map(()=>`
  <div class="skeleton-card">
    <div class="skel-line" style="height:20px;width:60%;margin-bottom:14px"></div>
    <div class="skel-line" style="height:12px;width:95%"></div>
    <div class="skel-line" style="height:12px;width:80%"></div>
    <div class="skel-line" style="height:12px;width:88%"></div>
  </div>`).join("");

window.addEventListener("load", fetchNews);
</script>
</body>
